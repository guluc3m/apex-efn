{
  "name": "@apex/browser-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apex/redaction": "workspace:*",
    "@apex/shared-types": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@sentry/node": "^11.11.0",
    "bullmq": "^5.31.0",
    "got-scraping": "^4.0.0",
    "ioredis": "^5.4.0",
    "pino": "^10.4.0",
    "playwright": "^1.49.0",
    "puppeteer": "^23.11.0",
    "puppeteer-extra": "^3.3.0",
    "puppeteer-extra-plugin-stealth": "^2.11.0",
    "undici": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@apex/eslint-config": "workspace:*",
    "@apex/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
