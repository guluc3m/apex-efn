          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (platform, flag) (increase(trato_seller_confidence_manipulation_flags_total{platform=~\"$platform\"}[1d]))",
          "legendFormat": "{{platform}} {{flag}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Confidence score p50 and p10 per platform",
      "datasource": {
        "type": "prometheus",
