      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, platform) (rate(trato_seller_confidence_score_bucket{platform=~\"$platform\"}[1h])))",
          "legendFormat": "{{platform}} p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.1, sum by (le, platform) (rate(trato_seller_confidence_score_bucket{platform=~\"$platform\"}[1h])))",
          "legendFormat": "{{platform}} p10",
          "range": true
        }
      ]
    },
    {
