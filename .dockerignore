# Repo-root Docker build context, shared by every image that builds from the repository
# root (pnpm workspace): apps/web, apps/browser-worker and apps/mock-marketplace, plus the
# orchestrator (uv/hatchling) which also reads config/defaults at the repo root. Each
# Dockerfile copies only what it needs; this file keeps the context free of installed
# dependencies, build outputs, secrets and local tooling state.

# VCS and metadata
.git
.gitignore
.claude
.github
.husky
.vscode
.idea

# Installed dependencies and build outputs (rebuilt inside the image)
**/node_modules
**/.pnpm-store
**/.turbo
**/dist
**/.next
**/out
**/build
**/coverage
**/playwright-report
**/test-results

# Python environments and caches
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Docs, infra and media that no image needs
docs
infra
compose.yaml
*.png
*.jpg

# Local environment files and editor state (keep the checked-in example)
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/.env.local
**/*.swp
**/*.swo
.DS_Store
