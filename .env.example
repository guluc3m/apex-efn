# =============================================================================
# TRATO - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with real secrets

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://trato:trato@localhost:5432/trato?schema=public"
DATABASE_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# S3-compatible Storage (MinIO in dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_ATTACHMENTS="trato-attachments"
S3_BUCKET_CSV="trato-csv"
S3_BUCKET_AUDIT="trato-audit"
S3_REGION="us-east-1"

# -----------------------------------------------------------------------------
# Vault (dev mode, in-memory; root token is a public dev placeholder)
# -----------------------------------------------------------------------------
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="trato-dev-root-token"

# -----------------------------------------------------------------------------
# Authentication (Keycloak in dev, realm "trato" from infra/keycloak/realm-trato.json)
# -----------------------------------------------------------------------------
AUTH_ISSUER_URL="http://localhost:8080/realms/trato"
AUTH_CLIENT_ID="trato-web"
# DEV ONLY placeholder, matches the secret in the realm file. Never use it outside local.
AUTH_CLIENT_SECRET="trato-dev-web-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-string"

# -----------------------------------------------------------------------------
# LLM Gateway (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# In development, point to the local stub or vLLM instance
LLM_GATEWAY_URL="http://localhost:8001/v1"
LLM_GATEWAY_API_KEY=""

# Per-role model configuration (base_url can override gateway for specific roles)
LLM_PLANNER_MODEL="gpt-4o"
LLM_NEGOTIATOR_MODEL="gpt-4o"
LLM_EXTRACTOR_MODEL="gpt-4o-mini"
LLM_NARRATOR_MODEL="gpt-4o-mini"
LLM_EMBEDDER_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Proxies (for browser-worker scraping)
# -----------------------------------------------------------------------------
PROXY_RESIDENTIAL_URL=""
PROXY_DATACENTER_URL=""

# -----------------------------------------------------------------------------
# Feature Flags (Unleash, dev instance from compose)
# -----------------------------------------------------------------------------
UNLEASH_URL="http://localhost:4242/api"
# DEV ONLY client token, matches INIT_CLIENT_API_TOKENS in infra/docker-compose.yml.
UNLEASH_API_TOKEN="default:development.trato-dev-unleash-client"

# -----------------------------------------------------------------------------
# Signing & Cryptography
# -----------------------------------------------------------------------------
# KMS key ID for service signing keys (AWS KMS, Vault Transit, etc.)
KMS_KEY_ID=""
KMS_ENDPOINT=""

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"

# Default tenant configuration (for development)
DEFAULT_TENANT_ID="dev-tenant"
