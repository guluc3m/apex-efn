        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (platform) (increase(trato_seller_confidence_assessments_total{platform=~\"$platform\",band=\"insufficient_data\"}[1d])) / sum by (platform) (increase(trato_seller_confidence_assessments_total{platform=~\"$platform\"}[1d]))",
          "legendFormat": "{{platform}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Manipulation flags per platform (last day)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
