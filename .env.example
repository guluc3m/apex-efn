# =============================================================================
# APEX-EFN - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with real secrets

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
# Owner/schema-owner DSN used by Prisma (`pnpm db:migrate`, `db:seed`) and the BFF.
# The web app also uses it at sign-in to link `users.external_subject` (#270); see docs/security/rbac.md.
DATABASE_URL="postgresql://apex:apex@localhost:5432/apex?schema=public"
DATABASE_POOL_SIZE=10
# Application login role (D1-03, D2-04). It is a member of `apex_app`, so PostgreSQL row-level
# security applies to it. Create/update it after the migrations with `pnpm db:bootstrap`.
# DEV ONLY password (see docs/runbooks/local-dev.md, "Database roles").
APEX_APP_DB_PASSWORD="apex_app_dev"
# Migrations, seed and load_defaults run as the schema owner (bypasses RLS), never as the app role.
MIGRATE_DATABASE_URL="postgresql://apex:apex@localhost:5432/apex"
# The orchestrator runtime uses the app role plus the asyncpg driver:
#   DATABASE_URL="postgresql+asyncpg://apex_app_login:${APEX_APP_DB_PASSWORD}@localhost:5432/apex"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Host ports compose publishes; override when another local service already uses them.
# REDIS_HOST_PORT=6379 (then point REDIS_URL at it)
# LOKI_HOST_PORT=3100
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# S3-compatible Storage (SeaweedFS in dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="any"
S3_SECRET_KEY="any"
S3_BUCKET_ATTACHMENTS="apex-attachments"
S3_BUCKET_CSV="apex-csv"
S3_BUCKET_AUDIT="apex-audit"
S3_REGION="us-east-1"

# -----------------------------------------------------------------------------
# Vault (dev mode, in-memory; root token is a public dev placeholder)
# -----------------------------------------------------------------------------
VAULT_ADDR="http://localhost:8200"
VAULT_TOKEN="apex-dev-root-token"

# -----------------------------------------------------------------------------
# Authentication (Keycloak in dev, realm "apex" from infra/keycloak/realm-apex.json)
# -----------------------------------------------------------------------------
# Web (Auth.js v5). Generate a real secret with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-generate-a-random-32-byte-string"
AUTH_KEYCLOAK_ID="apex-web"
# DEV ONLY placeholder, matches the secret in the realm file. Never use it outside local.
AUTH_KEYCLOAK_SECRET="apex-dev-web-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/apex"
AUTH_URL="http://localhost:3000"

# Orchestrator (D1-05). The issuer is the browser-facing URL that appears in the token's `iss`.
# Leave APEX_AUTH_JWKS_URL empty when the orchestrator runs on the host (it derives
# {issuer}/protocol/openid-connect/certs); in compose it is set to the `keycloak` service.
APEX_AUTH_ISSUER="http://localhost:8080/realms/apex"
APEX_AUTH_AUDIENCE="apex-orchestrator"
APEX_AUTH_JWKS_URL=""

# Dev-only escape hatch: accept X-Tenant-Id when no bearer token is present. Never true outside a
# developer machine. APEX_DEV_ROLES is a comma list of owner|admin|buyer|finance|viewer.
APEX_ALLOW_TENANT_HEADER="false"
APEX_DEV_ROLES=""

# -----------------------------------------------------------------------------
# LLM Gateway (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# In development, point to the local stub or vLLM instance
LLM_GATEWAY_URL="http://localhost:8001/v1"
LLM_GATEWAY_API_KEY=""

# Per-role model configuration (base_url can override gateway for specific roles)
LLM_PLANNER_MODEL="gpt-4o"
LLM_NEGOTIATOR_MODEL="gpt-4o"
LLM_EXTRACTOR_MODEL="gpt-4o-mini"
LLM_NARRATOR_MODEL="gpt-4o-mini"
LLM_EMBEDDER_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Proxies (for browser-worker scraping)
# -----------------------------------------------------------------------------
PROXY_RESIDENTIAL_URL=""
PROXY_DATACENTER_URL=""

# -----------------------------------------------------------------------------
# Browser stack (ADR-500, compose profile `browser`, used by the browser worker D5-02)
# -----------------------------------------------------------------------------
# Playwright connects to the shared Camoufox server: firefox.connect(CAMOUFOX_WS_ENDPOINT).
# The worker's playwright-core must match the image's Playwright major.minor.
# From the host use ws://localhost:13000/camoufox (13000 is mapped to container 3000).
CAMOUFOX_WS_ENDPOINT="ws://camoufox:3000/camoufox"
# crw is a Firecrawl-compatible crawler (POST /v1/scrape). From the host: http://localhost:13001.
CRW_BASE_URL="http://crw:3000"

# -----------------------------------------------------------------------------
# Feature Flags (Unleash, dev instance from compose)
# -----------------------------------------------------------------------------
UNLEASH_URL="http://localhost:4242/api"
# DEV ONLY client token, matches INIT_CLIENT_API_TOKENS in infra/docker-compose.yml.
UNLEASH_API_TOKEN="default:development.apex-dev-unleash-client"

# -----------------------------------------------------------------------------
# Signing & Cryptography
# -----------------------------------------------------------------------------
# KMS key ID for service signing keys (AWS KMS, Vault Transit, etc.)
KMS_KEY_ID=""
KMS_ENDPOINT=""

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"

# Default tenant configuration (for development)
DEFAULT_TENANT_ID="dev-tenant"
