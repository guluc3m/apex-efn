// APEX-EFN database schema (D2-03, ADR-201, ADR-205).
//
// Prisma Migrate is the only owner of DDL (ADR-201). The orchestrator maps these tables with SQLAlchemy
// (D2-05) and never migrates. Objects Prisma cannot model (append-only triggers, CHECK constraints,
// partial and expression indexes, RLS) are raw SQL inside the migrations.
//
// Conventions (ADR-205):
// - IDs are text, generated by the application (ULIDs from apex.common.ids). No database defaults.
// - Money is a BigInt `<name>_minor` column plus a `Currency` column. Never floats.
// - FX rates and statistics are Decimal. Percentages are basis points (Int).
// - Timestamps are timestamptz(6). Clocks are injected by the application, so there is no `now()` default.
// - Actors are polymorphic (`*_type` ActorType + `*_id`), so services and agents can act and sign.
// - `config_version` is the integer tenant config version (ADR-400).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// =============================================================================
// Shared enums
// =============================================================================

enum Currency {
  EUR
  USD
  CNY
}

enum Role {
  owner
  admin
  buyer
  finance
  viewer
}

enum ActorType {
  human
  service
  agent
}

// =============================================================================
// Tenancy and identity
// =============================================================================

model Tenant {
  id           String   @id
  name         String
  vatNumber    String?  @map("vat_number")
  country      String   @db.Char(2)
  baseCurrency Currency @map("base_currency")
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)

  memberships           Membership[]
  onboardingSessions    OnboardingSession[]
  companyProfile        CompanyProfile?
  financialImports      FinancialImport[]
  financialRows         FinancialRow[]
  financialSnapshots    CompanyFinancialsSnapshot[]
  budgetEnvelopes       BudgetEnvelope[]
  credentialRefs        CredentialRef[]
  connectedAccounts     ConnectedAccount[]
  profilePreferences    UserProfilePreference[]
  configVersions        TenantConfigVersion[]
  sourcingRequests      SourcingRequest[]
  sourcingItems         SourcingItem[]
  sourcingPlans         SourcingPlan[]
  missions              Mission[]
  sellerConfidences     SellerConfidence[]
  reviewAnomalies       ReviewAnomaly[]
  offers                Offer[]
  priceSanityChecks     PriceSanityCheck[]
  priceHistory          PriceHistory[]
  financialFits         FinancialFit[]
  negotiations          Negotiation[]
  negotiationMessages   NegotiationMessage[]
  negotiationOutcomes   NegotiationOutcome[]
  scores                Score[]
  scoreBreakdowns       ScoreBreakdown[]
  recommendations       Recommendation[]
  gateQueueItems        GateQueueItem[]
  signingKeys           SigningKey[]
  signingSessions       SigningSession[]
  decisions             Decision[]
  signatures            Signature[]
  approvals             Approval[]
  auditEvents           AuditEvent[]
  llmEvents             LlmEvent[]
  effectLedger          EffectLedgerEntry[]
  productEmbeddings     ProductEmbedding[]
  negotiationEmbeddings NegotiationEmbedding[]

  @@map("tenants")
}

model User {
  id              String   @id
  email           String   @unique
  displayName     String   @map("display_name")
  /// OIDC `sub` from Keycloak. Null until the user first signs in.
  externalSubject String?  @unique @map("external_subject")
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(6)

  memberships     Membership[]
  signingKeys     SigningKey[]
  signingSessions SigningSession[]
  approvals       Approval[]

  @@map("users")
}

model Membership {
  id        String   @id
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      Role
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// =============================================================================
// Onboarding, company profile and financials (spec 3.1, 3.1.1)
// =============================================================================

enum OnboardingStatus {
  profiling
  financials_pending
  financials_imported
  active
  completed
}

enum PurchaseFrequency {
  weekly
  monthly
  quarterly
  yearly
  ad_hoc
}

model OnboardingSession {
  id          String           @id
  tenantId    String           @map("tenant_id")
  status      OnboardingStatus
  createdById String           @map("created_by_id")
  createdAt   DateTime         @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  imports FinancialImport[]

  @@index([tenantId])
  @@map("onboarding_sessions")
}

model CompanyProfile {
  id                 String             @id
  tenantId           String             @unique @map("tenant_id")
  legalName          String             @map("legal_name")
  taxId              String             @map("tax_id")
  country            String             @db.Char(2)
  shippingAddress    String?            @map("shipping_address")
  billingAddress     String?            @map("billing_address")
  customsRegime      String?            @map("customs_regime")
  cnae               String?
  sector             String?
  purchaseCategories String[]           @map("purchase_categories")
  purchaseFrequency  PurchaseFrequency? @map("purchase_frequency")
  seasonality        String?
  baseCurrency       Currency           @map("base_currency")
  budgetMinor        BigInt?            @map("budget_minor")
  budgetCurrency     Currency?          @map("budget_currency")
  createdAt          DateTime           @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("company_profiles")
}

enum FinancialImportStatus {
  draft
  active
  superseded
  rejected
}

/// One uploaded CSV and its deterministic import report (spec 3.1.1). Becomes `active` only through a signed
/// decision, together with its CompanyFinancialsSnapshot.
model FinancialImport {
  id                     String                @id
  tenantId               String                @map("tenant_id")
  onboardingSessionId    String?               @map("onboarding_session_id")
  status                 FinancialImportStatus
  csvRef                 String                @map("csv_ref")
  csvSha256              String                @map("csv_sha256")
  baseCurrency           Currency              @map("base_currency")
  report                 Json
  rowsOk                 Int                   @map("rows_ok")
  rowsRejected           Int                   @map("rows_rejected")
  projectionEnabled      Boolean               @map("projection_enabled")
  periodsLoaded          Int                   @map("periods_loaded")
  referenceDate          DateTime?             @map("reference_date") @db.Date
  netBuyingCapacityMinor BigInt?               @map("net_buying_capacity_minor")
  /// Informational only (ADR-900 Q2). Null until DEV-3's formula ADR is approved.
  buyingPowerScore       Int?                  @map("buying_power_score")
  createdByType          ActorType             @map("created_by_type")
  createdById            String                @map("created_by_id")
  createdAt              DateTime              @map("created_at") @db.Timestamptz(6)

  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  onboardingSession OnboardingSession?         @relation(fields: [onboardingSessionId], references: [id])
  rows              FinancialRow[]
  envelopes         BudgetEnvelope[]
  snapshot          CompanyFinancialsSnapshot?

  @@index([tenantId, status])
  @@map("financial_imports")
}

/// Closed metric enum of spec 3.1.1, plus `budget` (ADR-900 Q2: envelopes come from per-category budget rows).
enum FinancialMetric {
  cash_balance
  credit_line_available
  credit_line_limit
  accounts_receivable
  accounts_payable
  revenue
  cogs
  fixed_costs
  payroll
  debt_service
  capex
  tax_reserve
  safety_buffer_pct
  payment_term_days
  budget
}

/// A parsed, accepted CSV row. Immutable. Rejected rows live only in the import report.
model FinancialRow {
  id                 String          @id
  tenantId           String          @map("tenant_id")
  importId           String          @map("import_id")
  rowNumber          Int             @map("row_number")
  period             String          @db.Char(7)
  metric             FinancialMetric
  category           String?
  valueMinor         BigInt?         @map("value_minor")
  valueBp            Int?            @map("value_bp")
  currency           Currency?
  originalValueMinor BigInt?         @map("original_value_minor")
  originalCurrency   Currency?       @map("original_currency")
  fxRate             Decimal?        @map("fx_rate") @db.Decimal(24, 12)
  fxAsOf             DateTime?       @map("fx_as_of") @db.Timestamptz(6)
  fxSource           String?         @map("fx_source")
  converted          Boolean
  notes              String?         @db.VarChar(500)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  import FinancialImport @relation(fields: [importId], references: [id])

  @@unique([importId, rowNumber])
  @@index([tenantId, metric, period])
  @@map("financial_rows")
}

enum FinancialSnapshotStatus {
  active
  superseded
}

/// The active financial picture of a tenant (spec 6). Immutable except the single transition
/// active -> superseded. At most one active snapshot per tenant.
model CompanyFinancialsSnapshot {
  id            String                  @id
  tenantId      String                  @map("tenant_id")
  importId      String                  @unique @map("import_id")
  version       Int
  status        FinancialSnapshotStatus
  baseCurrency  Currency                @map("base_currency")
  decisionId    String                  @unique @map("decision_id")
  activatedAt   DateTime                @map("activated_at") @db.Timestamptz(6)
  activatedById String                  @map("activated_by_id")
  supersededAt  DateTime?               @map("superseded_at") @db.Timestamptz(6)
  createdAt     DateTime                @map("created_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  import        FinancialImport @relation(fields: [importId], references: [id])
  decision      Decision        @relation(fields: [decisionId], references: [id])
  financialFits FinancialFit[]

  @@unique([tenantId, version])
  @@map("financial_snapshots")
}

model BudgetEnvelope {
  id             String   @id
  tenantId       String   @map("tenant_id")
  importId       String   @map("import_id")
  category       String
  currency       Currency
  allocatedMinor BigInt   @map("allocated_minor")
  spentMinor     BigInt   @map("spent_minor")
  availableMinor BigInt   @map("available_minor")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  import FinancialImport @relation(fields: [importId], references: [id])

  @@unique([importId, category, periodStart])
  @@map("budget_envelopes")
}

// =============================================================================
// Connected marketplace accounts (credentials stay in Vault)
// =============================================================================

/// Opaque pointer to a secret in Vault. Never holds the secret itself.
model CredentialRef {
  id        String    @id
  tenantId  String    @map("tenant_id")
  vaultPath String    @map("vault_path")
  createdAt DateTime  @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  accounts ConnectedAccount[]

  @@index([tenantId])
  @@map("credential_refs")
}

enum ConnectedAccountStatus {
  active
  session_invalidated
  reauth_required
  disabled
}

model ConnectedAccount {
  id              String                 @id
  tenantId        String                 @map("tenant_id")
  platform        String
  label           String?
  status          ConnectedAccountStatus
  credentialRefId String                 @map("credential_ref_id")
  createdAt       DateTime               @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  credentialRef CredentialRef @relation(fields: [credentialRefId], references: [id])
  negotiations  Negotiation[]

  @@index([tenantId, platform])
  @@map("connected_accounts")
}

// =============================================================================
// Versioned configuration (ADR-400, ADR-205)
// =============================================================================

/// Append-only tenant configuration versions (ADR-400). `values` is the tenant layer, including category
/// overrides. This table holds the spec's PricingThresholdConfig (`sanity.*`) and ConfidenceModelConfig
/// (`seller.*`) as sections of one signed, versioned document (ADR-205).
model TenantConfigVersion {
  id            String    @id
  tenantId      String    @map("tenant_id")
  configVersion Int       @map("config_version")
  contentHash   String    @map("content_hash")
  values        Json
  /// Signed decision that created this version. Null only for the seeded v1 baseline.
  decisionId    String?   @unique @map("decision_id")
  createdByType ActorType @map("created_by_type")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  decision          Decision?          @relation(fields: [decisionId], references: [id])
  missions          Mission[]
  priceSanityChecks PriceSanityCheck[]
  sellerConfidences SellerConfidence[]
  financialFits     FinancialFit[]
  scores            Score[]
  recommendations   Recommendation[]

  @@unique([tenantId, configVersion])
  @@map("tenant_config_versions")
}

/// A buyer profile: MCDA weights, negotiation parameters and hard constraints (spec 6). Append-only
/// versions per `profile_key`. This is the spec's ScoringWeightsConfig (ADR-205).
model UserProfilePreference {
  id              String    @id
  tenantId        String    @map("tenant_id")
  profileKey      String    @map("profile_key")
  version         Int
  name            String
  weights         Json
  negotiation     Json
  hardConstraints Json      @map("hard_constraints")
  decisionId      String?   @unique @map("decision_id")
  createdByType   ActorType @map("created_by_type")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  decision        Decision?        @relation(fields: [decisionId], references: [id])
  scores          Score[]
  recommendations Recommendation[]

  @@unique([tenantId, profileKey, version])
  @@map("user_profile_preferences")
}

// =============================================================================
// Sourcing and missions (spec 3.2)
// =============================================================================

enum SourcingRequestStatus {
  normalized
  needs_clarification
}

model SourcingRequest {
  id                 String                @id
  tenantId           String                @map("tenant_id")
  createdById        String                @map("created_by_id")
  status             SourcingRequestStatus
  rawText            String?               @map("raw_text")
  spec               Json
  quantityTiers      Json                  @map("quantity_tiers")
  maxBudgetMinor     BigInt?               @map("max_budget_minor")
  maxBudgetCurrency  Currency?             @map("max_budget_currency")
  targetDeliveryDate DateTime?             @map("target_delivery_date") @db.Date
  deliveryCountry    String                @map("delivery_country") @db.Char(2)
  deliveryAddress    String?               @map("delivery_address")
  excludedPlatforms  String[]              @map("excluded_platforms")
  excludedCountries  String[]              @map("excluded_countries")
  excludedSellers    String[]              @map("excluded_sellers")
  needsClarification String[]              @map("needs_clarification")
  createdAt          DateTime              @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  items    SourcingItem[]
  plans    SourcingPlan[]
  missions Mission[]

  @@index([tenantId, createdAt])
  @@map("sourcing_requests")
}

model SourcingItem {
  id            String @id
  tenantId      String @map("tenant_id")
  requestId     String @map("request_id")
  position      Int
  spec          Json
  quantityTiers Json   @map("quantity_tiers")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  request SourcingRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, position])
  @@map("sourcing_items")
}

model SourcingPlan {
  id        String   @id
  tenantId  String   @map("tenant_id")
  requestId String   @map("request_id")
  platforms String[]
  queries   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  request  SourcingRequest @relation(fields: [requestId], references: [id])
  missions Mission[]

  @@index([requestId])
  @@map("sourcing_plans")
}

enum MissionState {
  created
  planning
  sourcing
  enriching
  evaluating
  negotiating
  awaiting_decision
  completed
  cancelled
  failed
}

model Mission {
  id               String       @id
  tenantId         String       @map("tenant_id")
  requestId        String       @map("request_id")
  planId           String?      @map("plan_id")
  state            MissionState
  configVersion    Int          @map("config_version")
  offersDiscovered Int          @map("offers_discovered")
  offersNegotiated Int          @map("offers_negotiated")
  offersInGate     Int          @map("offers_in_gate")
  tokensUsed       BigInt       @map("tokens_used")
  tokenBudget      BigInt       @map("token_budget")
  startedAt        DateTime     @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)
  /// RFC 9457 problem when the mission failed.
  error            Json?

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  request         SourcingRequest     @relation(fields: [requestId], references: [id])
  plan            SourcingPlan?       @relation(fields: [planId], references: [id])
  config          TenantConfigVersion @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])
  offers          Offer[]
  gateQueueItems  GateQueueItem[]
  recommendations Recommendation[]
  priceHistory    PriceHistory[]
  llmEvents       LlmEvent[]

  @@index([tenantId, state])
  @@map("missions")
}

// =============================================================================
// Sellers and confidence (spec 3.4)
// =============================================================================

/// A marketplace seller. Global: the same seller is seen by every tenant. Confidence is per tenant.
model Seller {
  id          String   @id
  canonicalId String   @unique @map("canonical_id")
  name        String
  country     String?  @db.Char(2)
  riskFlags   String[] @map("risk_flags")
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  platformIds     SellerPlatformId[]
  signalSnapshots SellerSignalSnapshot[]
  confidences     SellerConfidence[]
  reviewAnomalies ReviewAnomaly[]
  offers          Offer[]
  priceHistory    PriceHistory[]

  @@map("sellers")
}

model SellerPlatformId {
  id               String @id
  sellerId         String @map("seller_id")
  platform         String
  platformSellerId String @map("platform_seller_id")

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([platform, platformSellerId])
  @@index([sellerId])
  @@map("seller_platform_ids")
}

/// Raw seller signals as captured from a platform (spec 6). Global and append-only.
model SellerSignalSnapshot {
  id                     String    @id
  sellerId               String    @map("seller_id")
  platform               String
  accountAgeDays         Int?      @map("account_age_days")
  firstSaleDate          DateTime? @map("first_sale_date") @db.Date
  monthsActiveLast12     Int?      @map("months_active_last_12")
  lifetimeTransactions   BigInt?   @map("lifetime_transactions")
  transactions12m        BigInt?   @map("transactions_12m")
  gmv12mMinor            BigInt?   @map("gmv_12m_minor")
  gmv12mCurrency         Currency? @map("gmv_12m_currency")
  repeatBuyerShare       Decimal?  @map("repeat_buyer_share") @db.Decimal(7, 6)
  publishedProductsCount Int?      @map("published_products_count")
  catalogChurn30d        Decimal?  @map("catalog_churn_30d") @db.Decimal(7, 6)
  specCompletenessAvg    Decimal?  @map("spec_completeness_avg") @db.Decimal(7, 6)
  reviewsTotal           BigInt?   @map("reviews_total")
  reviews12m             BigInt?   @map("reviews_12m")
  ratingAvg              Decimal?  @map("rating_avg") @db.Decimal(4, 3)
  ratingCount            BigInt?   @map("rating_count")
  verifiedReviewShare    Decimal?  @map("verified_review_share") @db.Decimal(7, 6)
  responseRate           Decimal?  @map("response_rate") @db.Decimal(7, 6)
  identityVerified       Boolean?  @map("identity_verified")
  tradeAssurance         Boolean?  @map("trade_assurance")
  escrowAvailable        Boolean?  @map("escrow_available")
  disputeRate            Decimal?  @map("dispute_rate") @db.Decimal(7, 6)
  refundRate             Decimal?  @map("refund_rate") @db.Decimal(7, 6)
  /// Number of raw signals present (ADR-900 Q3: `seller.min_signals` counts these).
  signalCount            Int       @map("signal_count")
  dataCompleteness       Decimal   @map("data_completeness") @db.Decimal(5, 4)
  /// Adapter payload as received, for re-computation. Never contains credentials.
  raw                    Json
  capturedAt             DateTime  @map("captured_at") @db.Timestamptz(6)

  seller          Seller             @relation(fields: [sellerId], references: [id])
  confidences     SellerConfidence[]
  reviewAnomalies ReviewAnomaly[]

  @@index([sellerId, capturedAt])
  @@map("seller_signal_snapshots")
}

enum SellerConfidenceBand {
  high
  medium
  low
  untrusted
  insufficient_data
}

/// Deterministic confidence of a seller for one tenant (spec 3.4.2). Append-only.
model SellerConfidence {
  id                String               @id
  tenantId          String               @map("tenant_id")
  sellerId          String               @map("seller_id")
  snapshotId        String?              @map("snapshot_id")
  /// Null when the band is `insufficient_data`.
  score             Int?
  band              SellerConfidenceBand
  signalsNormalized Json                 @map("signals_normalized")
  penalties         String[]
  flags             Json
  modelVersion      String               @map("model_version")
  configVersion     Int                  @map("config_version")
  computedAt        DateTime             @map("computed_at") @db.Timestamptz(6)

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  seller              Seller                @relation(fields: [sellerId], references: [id])
  snapshot            SellerSignalSnapshot? @relation(fields: [snapshotId], references: [id])
  config              TenantConfigVersion   @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])
  negotiationOutcomes NegotiationOutcome[]

  @@index([tenantId, sellerId, computedAt])
  @@map("seller_confidences")
}

enum ReviewAnomalyType {
  burst_velocity
  five_star_anomaly
  low_verified_share
  duplicate_text
  creation_correlation
}

enum ReviewAnomalySeverity {
  warning
  critical
}

model ReviewAnomaly {
  id         String                @id
  tenantId   String                @map("tenant_id")
  sellerId   String                @map("seller_id")
  snapshotId String?               @map("snapshot_id")
  type       ReviewAnomalyType
  severity   ReviewAnomalySeverity
  evidence   Json
  detectedAt DateTime              @map("detected_at") @db.Timestamptz(6)

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  seller   Seller                @relation(fields: [sellerId], references: [id])
  snapshot SellerSignalSnapshot? @relation(fields: [snapshotId], references: [id])

  @@index([tenantId, sellerId])
  @@map("review_anomalies")
}

// =============================================================================
// Offers (spec 3.2, per-offer state machine of spec 4)
// =============================================================================

enum OfferState {
  discovered
  enriched
  trust_scored
  sanity_checked
  gate_pending
  gate_approved
  gate_rejected
  financially_checked
  negotiating
  negotiated
  sanity_rechecked
  scored
  awaiting_human
  signed
  approved
  rejected
  purchased
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

model Offer {
  id                  String     @id
  tenantId            String     @map("tenant_id")
  missionId           String     @map("mission_id")
  platform            String
  platformOfferId     String     @map("platform_offer_id")
  productUrl          String?    @map("product_url")
  productKey          String     @map("product_key")
  title               String
  description         String?
  specifications      Json
  certifications      String[]
  imageUrls           String[]   @map("image_urls")
  sellerId            String     @map("seller_id")
  sellerName          String     @map("seller_name")
  sellerCountry       String?    @map("seller_country") @db.Char(2)
  /// Unit price in the tenant's base currency (spec 3.5.1).
  unitPriceMinor      BigInt     @map("unit_price_minor")
  currency            Currency
  originalAmountMinor BigInt?    @map("original_amount_minor")
  originalCurrency    Currency?  @map("original_currency")
  fxRate              Decimal?   @map("fx_rate") @db.Decimal(24, 12)
  fxAsOf              DateTime?  @map("fx_as_of") @db.Timestamptz(6)
  fxSource            String?    @map("fx_source")
  converted           Boolean
  fxProvisional       Boolean    @map("fx_provisional")
  moq                 Int
  priceTiers          Json       @map("price_tiers")
  shipping            Json?
  incoterm            Incoterm?
  leadTimeDays        Int?       @map("lead_time_days")
  state               OfferState
  discoveredAt        DateTime   @map("discovered_at") @db.Timestamptz(6)
  expiresAt           DateTime?  @map("expires_at") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  mission             Mission              @relation(fields: [missionId], references: [id])
  seller              Seller               @relation(fields: [sellerId], references: [id])
  priceSanityChecks   PriceSanityCheck[]
  financialFits       FinancialFit[]
  negotiations        Negotiation[]
  negotiationOutcomes NegotiationOutcome[]
  scores              Score[]
  gateQueueItems      GateQueueItem[]
  priceHistory        PriceHistory[]
  embeddings          ProductEmbedding[]

  @@unique([missionId, platform, platformOfferId])
  @@index([tenantId, missionId, state])
  @@index([sellerId])
  @@index([productKey])
  @@map("offers")
}

// =============================================================================
// Price sanity and financial fit (spec 3.3, 3.5)
// =============================================================================

enum PriceSanityBand {
  normal
  atypical
  implausible
  insufficient_reference
}

enum SanityDecision {
  negotiate
  human_gate
  discard
}

enum DispersionMeasure {
  mad
  iqr
  relative
}

enum SanityStage {
  listed
  negotiated
}

model PriceSanityCheck {
  id                     String             @id
  tenantId               String             @map("tenant_id")
  offerId                String             @map("offer_id")
  /// `listed` before negotiation, `negotiated` for the re-check of a quoted price (spec 3.6 step 4).
  stage                  SanityStage
  /// Landed cost per unit in EUR minor units.
  referencePriceEurMinor BigInt             @map("reference_price_eur_minor")
  /// Null when the reference sample is too small to compute one.
  medianEurMinor         BigInt?            @map("median_eur_minor")
  dispersionMeasure      DispersionMeasure? @map("dispersion_measure")
  dispersionValue        Decimal?           @map("dispersion_value") @db.Decimal(30, 10)
  sampleSize             Int                @map("sample_size")
  indexScore             Decimal?           @map("index_score") @db.Decimal(20, 10)
  relativeDeviation      Decimal?           @map("relative_deviation") @db.Decimal(20, 10)
  band                   PriceSanityBand
  decision               SanityDecision
  explanations           Json
  configVersion          Int                @map("config_version")
  checkedAt              DateTime           @map("checked_at") @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  offer  Offer               @relation(fields: [offerId], references: [id])
  config TenantConfigVersion @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])

  @@index([tenantId, offerId, checkedAt])
  @@map("price_sanity_checks")
}

/// Price memory per tenant (spec 3.3.1 reference universe, D4-14).
model PriceHistory {
  id                     String   @id
  tenantId               String   @map("tenant_id")
  productKey             String   @map("product_key")
  sellerId               String   @map("seller_id")
  landedUnitCostEurMinor BigInt   @map("landed_unit_cost_eur_minor")
  date                   DateTime @db.Date
  missionId              String?  @map("mission_id")
  offerId                String?  @map("offer_id")
  createdAt              DateTime @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  seller  Seller   @relation(fields: [sellerId], references: [id])
  mission Mission? @relation(fields: [missionId], references: [id])
  offer   Offer?   @relation(fields: [offerId], references: [id])

  @@index([tenantId, productKey, date])
  @@map("price_history")
}

/// Daily FX rates (ECB reference rates, ADR-900 Q6). Global and append-only.
model FxRate {
  id         String   @id
  base       Currency
  quote      Currency
  rate       Decimal  @db.Decimal(24, 12)
  asOf       DateTime @map("as_of") @db.Timestamptz(6)
  source     String
  ingestedAt DateTime @map("ingested_at") @db.Timestamptz(6)

  @@unique([base, quote, asOf, source])
  @@index([base, quote, asOf])
  @@map("fx_rates")
}

enum FinancialVerdict {
  within_budget
  stretch
  out_of_budget
}

model FinancialFit {
  id                  String           @id
  tenantId            String           @map("tenant_id")
  offerId             String           @map("offer_id")
  snapshotId          String?          @map("snapshot_id")
  quantity            Int
  currency            Currency
  landedTotalMinor    BigInt           @map("landed_total_minor")
  unitLandedCostMinor BigInt           @map("unit_landed_cost_minor")
  /// Line-by-line LandedCostBreakdown (spec 3.5).
  landedCost          Json             @map("landed_cost")
  verdict             FinancialVerdict
  reasons             String[]
  budgetUtilizationBp Int?             @map("budget_utilization_bp")
  treasuryImpactMinor BigInt?          @map("treasury_impact_minor")
  financialsStale     Boolean          @map("financials_stale")
  fxProvisional       Boolean          @map("fx_provisional")
  configVersion       Int              @map("config_version")
  computedAt          DateTime         @map("computed_at") @db.Timestamptz(6)

  tenant   Tenant                     @relation(fields: [tenantId], references: [id])
  offer    Offer                      @relation(fields: [offerId], references: [id])
  snapshot CompanyFinancialsSnapshot? @relation(fields: [snapshotId], references: [id])
  config   TenantConfigVersion        @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])

  @@index([tenantId, offerId, computedAt])
  @@map("financial_fits")
}

// =============================================================================
// Negotiation (spec 3.6)
// =============================================================================

enum NegotiationState {
  queued
  running
  awaiting_approval
  human_control
  paused
  completed
  aborted
  escalated
}

model Negotiation {
  id                 String           @id
  tenantId           String           @map("tenant_id")
  offerId            String           @map("offer_id")
  /// Starts at 1. `renegotiate` opens a new attempt (ADR-900, ADR-403 item 4).
  attempt            Int
  /// `negotiate:<subject_ref>:<attempt>`.
  idempotencyKey     String           @unique @map("idempotency_key")
  connectedAccountId String?          @map("connected_account_id")
  strategy           String
  state              NegotiationState
  rounds             Int
  maxRounds          Int?             @map("max_rounds")
  guardrailHits      Json             @map("guardrail_hits")
  controlledById     String?          @map("controlled_by_id")
  startedAt          DateTime         @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  offer            Offer                  @relation(fields: [offerId], references: [id])
  connectedAccount ConnectedAccount?      @relation(fields: [connectedAccountId], references: [id])
  messages         NegotiationMessage[]
  outcome          NegotiationOutcome?
  embeddings       NegotiationEmbedding[]

  @@unique([offerId, attempt])
  @@index([tenantId, state])
  @@map("negotiations")
}

enum MessageRole {
  agent
  seller
  human
}

enum MessageStatus {
  drafted
  approved
  sent
  received
  discarded
}

model NegotiationMessage {
  id            String        @id
  tenantId      String        @map("tenant_id")
  negotiationId String        @map("negotiation_id")
  seq           Int
  role          MessageRole
  status        MessageStatus
  content       String
  at            DateTime      @db.Timestamptz(6)
  screenshotRef String?       @map("screenshot_ref")
  redactions    Int
  approvedById  String?       @map("approved_by_id")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  negotiation Negotiation @relation(fields: [negotiationId], references: [id])

  @@unique([negotiationId, seq])
  @@map("negotiation_messages")
}

/// Closed set from ADR-900 (ADR-403 item 4).
enum NegotiationOutcomeKind {
  agreed
  no_agreement
  escalated
  stopped_anomalous_price
  aborted
}

model NegotiationOutcome {
  id                 String                 @id
  tenantId           String                 @map("tenant_id")
  negotiationId      String                 @unique @map("negotiation_id")
  offerId            String                 @map("offer_id")
  outcome            NegotiationOutcomeKind
  currency           Currency
  initialPriceMinor  BigInt                 @map("initial_price_minor")
  /// Unit price, set only when the outcome is `agreed`.
  finalPriceMinor    BigInt?                @map("final_price_minor")
  quantity           Int?
  discountBp         Int?                   @map("discount_bp")
  concessions        Json
  terms              Json
  sellerConfidenceId String?                @map("seller_confidence_id")
  transcriptRef      String                 @map("transcript_ref")
  createdAt          DateTime               @map("created_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  negotiation      Negotiation       @relation(fields: [negotiationId], references: [id])
  offer            Offer             @relation(fields: [offerId], references: [id])
  sellerConfidence SellerConfidence? @relation(fields: [sellerConfidenceId], references: [id])

  @@index([tenantId, offerId])
  @@map("negotiation_outcomes")
}

// =============================================================================
// Scoring and recommendation (spec 3.7)
// =============================================================================

enum ScoreCriterion {
  landed_cost
  lead_time
  seller_confidence
  financial_fit
  margin_potential
  spec_match
  compliance_risk
  negotiation_gain
}

model Score {
  id            String   @id
  tenantId      String   @map("tenant_id")
  offerId       String   @map("offer_id")
  profileId     String   @map("profile_id")
  value         Decimal  @db.Decimal(20, 10)
  rank          Int?
  configVersion Int      @map("config_version")
  modelVersion  String   @map("model_version")
  computedAt    DateTime @map("computed_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  offer      Offer                 @relation(fields: [offerId], references: [id])
  profile    UserProfilePreference @relation(fields: [profileId], references: [id])
  config     TenantConfigVersion   @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])
  breakdowns ScoreBreakdown[]

  @@index([tenantId, offerId])
  @@map("scores")
}

model ScoreBreakdown {
  id              String         @id
  tenantId        String         @map("tenant_id")
  scoreId         String         @map("score_id")
  criterion       ScoreCriterion
  weight          Decimal        @db.Decimal(20, 10)
  /// Null when the input is unknown (D3-09 documents the treatment).
  normalizedValue Decimal?       @map("normalized_value") @db.Decimal(20, 10)
  contribution    Decimal        @db.Decimal(20, 10)
  penalty         Decimal        @db.Decimal(20, 10)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  score  Score  @relation(fields: [scoreId], references: [id])

  @@unique([scoreId, criterion])
  @@map("score_breakdowns")
}

model Recommendation {
  id            String   @id
  tenantId      String   @map("tenant_id")
  missionId     String   @map("mission_id")
  profileId     String   @map("profile_id")
  ranking       Json
  excluded      Json
  alternatives  Json
  savings       Json
  /// LLM narration of the numbers. Never the source of the ranking.
  narrative     String?
  configVersion Int      @map("config_version")
  modelVersion  String   @map("model_version")
  generatedAt   DateTime @map("generated_at") @db.Timestamptz(6)

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  mission Mission               @relation(fields: [missionId], references: [id])
  profile UserProfilePreference @relation(fields: [profileId], references: [id])
  config  TenantConfigVersion   @relation(fields: [tenantId, configVersion], references: [tenantId, configVersion])

  @@index([tenantId, missionId])
  @@map("recommendations")
}

// =============================================================================
// Gate queue (spec 3.8, D4-11)
// =============================================================================

enum GateReason {
  price_atypical
  price_insufficient_reference
  seller_low
  seller_insufficient_data
  out_of_budget
  stretch_above_threshold
  negotiator_escalated
  financials_stale
  fx_provisional
  dual_control_pending
  supervisor
}

enum GateStatus {
  open
  resolved
}

enum GateResolution {
  unblocked
  discarded
  overridden
  held
  followed
}

model GateQueueItem {
  id             String          @id
  tenantId       String          @map("tenant_id")
  missionId      String          @map("mission_id")
  /// Null for supervisor escalations that concern a whole mission (ADR-900, issue #99).
  offerId        String?         @map("offer_id")
  causes         GateReason[]
  status         GateStatus
  resolution     GateResolution?
  decisionId     String?         @unique @map("decision_id")
  assignedToId   String?         @map("assigned_to_id")
  slaDueAt       DateTime        @map("sla_due_at") @db.Timestamptz(6)
  reminderSentAt DateTime?       @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt      DateTime        @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  mission  Mission   @relation(fields: [missionId], references: [id])
  offer    Offer?    @relation(fields: [offerId], references: [id])
  decision Decision? @relation(fields: [decisionId], references: [id])

  @@index([tenantId, status, slaDueAt])
  @@map("gate_queue_items")
}

// =============================================================================
// Signing, decisions and audit (spec 5.10)
// =============================================================================

enum SigningKeyOwnerType {
  human
  service
}

/// Ed25519 public keys. Human keys belong to a user and a tenant. Service keys live in Vault Transit and may be
/// global (tenant null). Revoking a key never invalidates past signatures.
model SigningKey {
  id            String              @id
  ownerType     SigningKeyOwnerType @map("owner_type")
  ownerId       String              @map("owner_id")
  /// Set, and equal to owner_id, exactly when owner_type is human (CHECK in the migration).
  userId        String?             @map("user_id")
  tenantId      String?             @map("tenant_id")
  publicKey     String              @unique @map("public_key")
  alg           String
  label         String?
  vaultKeyRef   String?             @map("vault_key_ref")
  createdAt     DateTime            @map("created_at") @db.Timestamptz(6)
  rotatedAt     DateTime?           @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?             @map("revoked_reason")

  user        User?            @relation(fields: [userId], references: [id])
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  sessions    SigningSession[]
  signatures  Signature[]
  auditEvents AuditEvent[]

  @@index([ownerType, ownerId])
  @@index([tenantId])
  @@map("signing_keys")
}

enum AuthMethod {
  keycloak_step_up
}

enum SigningSessionStatus {
  active
  expired
  revoked
  exhausted
  closed
}

enum ReauthReason {
  session_missing
  session_expired
  session_revoked
  session_exhausted
  key_revoked
  key_rotated
  device_mismatch
  network_anomaly
  high_value_decision
  immediate_reauth_required
  risk_flagged
  step_up_required
}

/// Audit copy of a signing session. The live state is in Redis (D2-08). The window is fixed:
/// expires_at = auth_at + signing.session_minutes.
model SigningSession {
  id                   String               @id
  tenantId             String               @map("tenant_id")
  userId               String               @map("user_id")
  keyId                String               @map("key_id")
  authMethod           AuthMethod           @map("auth_method")
  authAt               DateTime             @map("auth_at") @db.Timestamptz(6)
  expiresAt            DateTime             @map("expires_at") @db.Timestamptz(6)
  deviceFingerprintRef String               @map("device_fingerprint_ref")
  decisionsSigned      String[]             @map("decisions_signed")
  maxDecisions         Int                  @map("max_decisions")
  status               SigningSessionStatus
  revokedReason        ReauthReason?        @map("revoked_reason")
  createdAt            DateTime             @map("created_at") @db.Timestamptz(6)
  endedAt              DateTime?            @map("ended_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  key        SigningKey  @relation(fields: [keyId], references: [id])
  signatures Signature[]

  @@index([tenantId, userId, status])
  @@map("signing_sessions")
}

enum DecisionType {
  follow
  renegotiate
  takeover
  hold
  discard
  approve_purchase
  financial_snapshot_activation
  gate_override_discard
  change_pricing_threshold
  change_confidence_weights
  change_scoring_weights
  rotate_key
  revoke_key
  gate_unblock
  config_change
  deal_action
  service_event
}

enum DecisionStatus {
  pending_signature
  signed
  rejected
  expired
}

/// A business decision with its canonical payload (RFC 8785). The payload is immutable once created.
model Decision {
  id                      String         @id
  tenantId                String         @map("tenant_id")
  type                    DecisionType
  subjectRef              String         @map("subject_ref")
  payloadCanonical        String         @map("payload_canonical")
  payloadHash             String         @map("payload_hash")
  status                  DecisionStatus
  requiresImmediateReauth Boolean        @map("requires_immediate_reauth")
  requiredSigners         Int            @map("required_signers")
  configVersion           Int?           @map("config_version")
  createdByType           ActorType      @map("created_by_type")
  createdById             String         @map("created_by_id")
  createdAt               DateTime       @map("created_at") @db.Timestamptz(6)
  signedAt                DateTime?      @map("signed_at") @db.Timestamptz(6)
  rejectedAt              DateTime?      @map("rejected_at") @db.Timestamptz(6)

  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  signatures        Signature[]
  approvals         Approval[]
  gateQueueItem     GateQueueItem?
  financialSnapshot CompanyFinancialsSnapshot?
  configVersionRow  TenantConfigVersion?
  profilePreference UserProfilePreference?

  @@index([tenantId, status])
  @@index([tenantId, subjectRef])
  @@map("decisions")
}

/// An Ed25519 signature over a decision payload, chained per tenant (D2-09). Append-only.
model Signature {
  id                String    @id
  tenantId          String    @map("tenant_id")
  decisionId        String    @map("decision_id")
  signerType        ActorType @map("signer_type")
  signerId          String    @map("signer_id")
  keyId             String    @map("key_id")
  alg               String
  payloadHash       String    @map("payload_hash")
  signature         String
  signedAt          DateTime  @map("signed_at") @db.Timestamptz(6)
  /// Required for human signers (CHECK in the migration). Services sign without a session.
  signingSessionId  String?   @map("signing_session_id")
  authAt            DateTime? @map("auth_at") @db.Timestamptz(6)
  prevSignatureHash String?   @map("prev_signature_hash")
  chainHash         String    @unique @map("chain_hash")
  clientAttestation String?   @map("client_attestation")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  decision Decision        @relation(fields: [decisionId], references: [id])
  key      SigningKey      @relation(fields: [keyId], references: [id])
  session  SigningSession? @relation(fields: [signingSessionId], references: [id])

  @@unique([decisionId, signerId])
  @@unique([tenantId, prevSignatureHash])
  @@index([tenantId, signedAt])
  @@map("signatures")
}

enum ApprovalDecision {
  approve
  reject
}

model Approval {
  id              String            @id
  tenantId        String            @map("tenant_id")
  decisionId      String            @map("decision_id")
  requestedByType ActorType         @map("requested_by_type")
  requestedById   String            @map("requested_by_id")
  approverId      String?           @map("approver_id")
  decision        ApprovalDecision?
  comment         String?
  createdAt       DateTime          @map("created_at") @db.Timestamptz(6)
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(6)

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  decisionRef Decision @relation(fields: [decisionId], references: [id])
  approver    User?    @relation(fields: [approverId], references: [id])

  @@index([tenantId, decisionId])
  @@map("approvals")
}

/// Hash-chained, append-only audit log per tenant (D2-10). `seq` starts at 1 and has no gaps.
model AuditEvent {
  id               String    @id
  tenantId         String    @map("tenant_id")
  seq              BigInt
  actorType        ActorType @map("actor_type")
  actorId          String    @map("actor_id")
  eventType        String    @map("event_type")
  subjectRef       String    @map("subject_ref")
  payload          Json
  payloadHash      String    @map("payload_hash")
  prevHash         String    @map("prev_hash")
  hash             String    @unique
  /// Service signature from sign_service_event, when the event is signed.
  serviceSignature String?   @map("service_signature")
  serviceKeyId     String?   @map("service_key_id")
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  serviceKey SigningKey? @relation(fields: [serviceKeyId], references: [id])

  @@unique([tenantId, seq])
  @@unique([tenantId, prevHash])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

// =============================================================================
// LLM accounting, idempotent effects and embeddings
// =============================================================================

enum LlmRole {
  planner
  negotiator
  extractor
  narrator
  embedder
}

model LlmEvent {
  id            String    @id
  /// Null for calls outside a tenant (evals, health checks).
  tenantId      String?   @map("tenant_id")
  missionId     String?   @map("mission_id")
  role          LlmRole
  endpoint      String
  model         String
  promptVersion String    @map("prompt_version")
  tokensIn      Int       @map("tokens_in")
  tokensOut     Int       @map("tokens_out")
  latencyMs     Int       @map("latency_ms")
  repairedJson  Boolean   @map("repaired_json")
  costMinor     BigInt?   @map("cost_minor")
  costCurrency  Currency? @map("cost_currency")
  gpuSeconds    Decimal?  @map("gpu_seconds") @db.Decimal(20, 6)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)

  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  mission Mission? @relation(fields: [missionId], references: [id])

  @@index([tenantId, missionId])
  @@map("llm_events")
}

/// Postgres backing of the graph's EffectLedger (ADR-403 item 5): an effect runs at most once per key.
model EffectLedgerEntry {
  id        String   @id
  tenantId  String   @map("tenant_id")
  key       String
  result    Json
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("effect_ledger")
}

/// Product embeddings for similarity and dedupe. Dimensions depend on the configured embedder model, so the
/// column has no fixed size. An ANN index is added per dimension once the model is fixed (ADR-205).
model ProductEmbedding {
  id         String                @id
  tenantId   String                @map("tenant_id")
  offerId    String?               @map("offer_id")
  productKey String                @map("product_key")
  model      String
  dimensions Int
  embedding  Unsupported("vector")
  createdAt  DateTime              @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer? @relation(fields: [offerId], references: [id])

  @@index([tenantId, productKey])
  @@map("product_embeddings")
}

model NegotiationEmbedding {
  id            String                @id
  tenantId      String                @map("tenant_id")
  negotiationId String                @map("negotiation_id")
  chunk         Int
  model         String
  dimensions    Int
  embedding     Unsupported("vector")
  createdAt     DateTime              @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  negotiation Negotiation @relation(fields: [negotiationId], references: [id])

  @@unique([negotiationId, chunk, model])
  @@map("negotiation_embeddings")
}
