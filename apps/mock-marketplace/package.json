{
  "name": "@apex/mock-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic marketplace (two platforms, seller fixtures, scripted chat personas) for tests and demos. Never deploy to production.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apex/eslint-config": "workspace:*",
    "@apex/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
