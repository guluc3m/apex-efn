{
  "name": "@apex/shared-types",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js"
    },
    "./contracts/zod": {
      "types": "./dist/generated/zod.gen.d.ts",
      "import": "./dist/generated/zod.gen.js"
    },
    "./contracts/browser-worker": {
      "types": "./dist/generated/browser-worker/index.d.ts",
      "import": "./dist/generated/browser-worker/index.js"
    },
    "./contracts/browser-worker/zod": {
      "types": "./dist/generated/browser-worker/zod.gen.d.ts",
      "import": "./dist/generated/browser-worker/zod.gen.js"
    },
    "./currency": {
      "types": "./dist/legacy/currency.d.ts",
      "import": "./dist/legacy/currency.js"
    },
    "./seller": {
      "types": "./dist/legacy/seller.d.ts",
      "import": "./dist/legacy/seller.js"
    },
    "./sanity": {
      "types": "./dist/legacy/sanity.d.ts",
      "import": "./dist/legacy/sanity.js"
    },
    "./signing": {
      "types": "./dist/legacy/signing.d.ts",
      "import": "./dist/legacy/signing.js"
    },
    "./config": {
      "types": "./dist/legacy/config.d.ts",
      "import": "./dist/legacy/config.js"
    },
    "./financial": {
      "types": "./dist/legacy/financial.d.ts",
      "import": "./dist/legacy/financial.js"
    },
    "./mission": {
      "types": "./dist/legacy/mission.d.ts",
      "import": "./dist/legacy/mission.js"
    },
    "./offer": {
      "types": "./dist/legacy/offer.d.ts",
      "import": "./dist/legacy/offer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apex/eslint-config": "workspace:*",
    "@apex/tsconfig": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
