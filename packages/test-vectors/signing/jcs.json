        "sha256": "460c3563e80d4d09f5754e081d81e5c11aa2f3d0325f0f0c77a120275058db62"
      }
    },
    {
      "name": "nested objects in arrays keep array order",
      "input": "[{\"b\":2,\"a\":1},[{\"d\":4,\"c\":3}],[],{}]",
